generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Post {
  id        Int       @id @default(autoincrement())
  title     String
  content   String
  comments  Comment[]
}

model Comment {
  id        Int     @id @default(autoincrement())
  postId    Int
  post      Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  content   String
}
